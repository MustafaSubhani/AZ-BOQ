# Copy to .env at the repo root and fill in. .env is not committed.
OPENAI_API_KEY=
# Deployed frontend, e.g. https://your-app.vercel.app (separate several with commas)
FRONTEND_URL=

# Optional. Leave these commented out to use the defaults; an empty value overrides the default.
# OPENAI_TRANSLATION_MODEL=gpt-5.6-sol
# OPENAI_VISION_MODEL=gpt-5.6-sol
# AZBOQ_ROOT=
# AZBOQ_DATA=
# AZBOQ_CACHE=
# AZBOQ_ODA=
